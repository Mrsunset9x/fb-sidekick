{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "1.1.8",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_extShortName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "permissions": ["storage", "declarativeNetRequest", "notifications"],
  "background": { "service_worker": "background.js", "type": "module" },
  "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_headers",
        "enabled": true,
        "path": "rules/frame-headers.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/messages*", "https://web.facebook.com/messages*"],
      "js": ["frame.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.facebook.com/messages*", "https://web.facebook.com/messages*"],
      "js": ["quiet.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
